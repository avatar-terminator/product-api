classDiagram
    class Customer {
        - Long id
        - String name
        - Address address
        - String[] tags
        - int customerCount$
        + Customer()
        + Customer(Long id, String name, Address address)
        + getId() Long
        + getName() String
        + getAddress() Address
        + getTags() String[]
        + getCustomerCount() int$
    }

    class Address {
        - String street
        - String city
        - String postCode
        + Address()
        + Address(String street, String city, String postCode)
        + getStreet() String
        + getCity() String
        + getPostCode() String
    }

    Customer --> Address